{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*)",
      "Bash",
      "bash(*)",
      "bash",
      "Read(*)",
      "Read",
      "read_file",
      "Write(*)",
      "Write",
      "write_file",
      "Edit(*)",
      "Edit",
      "edit_file",
      "MultiEdit",
      "ApplyPatch",
      "Grep",
      "grep_search",
      "Glob",
      "ls",
      "WebFetch(*)",
      "WebFetch",
      "fetch_url",
      "WebSearch(*)",
      "WebSearch",
      "search_web",
      "Notebook",
      "Task",
      "Skill",
      "TodoRead",
      "TodoWrite",
      "Lsp",
      "All"
    ]
  },
  "model": "agy/claude-sonnet-4-6",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "high",
  "apiTimeout": 300000,
  "smallFastModel": "agy/gemini-3.5-flash-low",
  "mcpServers": {
    "swarm": {
      "command": "python3",
      "args": [
        "<your-home>/.omniroute/swarm_mcp.py"
      ],
      "timeout": 30000,
      "initializationTimeout": 15000
    },
    "llmlingua": {
      "command": "python3",
      "args": [
        "<your-home>/.llmlingua-mcp/server.py"
      ],
      "timeout": 30000,
      "initializationTimeout": 15000
    }
  },
  "customInstructions": "IMPORTANT: All operating rules are defined in ~/.claude/CLAUDE.md. Read and follow them on every session.",
  "tui": "fullscreen"
}
